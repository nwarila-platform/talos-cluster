# Dedicated connector for the GitLab tunnel (terraform/cloudflare). Installed
# on the GitLab host by the operator (README: "GitLab edge"); mirrors the
# host's existing cloudflared-tunnel.service, with its own token file and
# metrics port so both connectors run side by side.
[Unit]
Description=Cloudflare Tunnel connector for GitLab
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cloudflared
Group=cloudflared
EnvironmentFile=/etc/cloudflared/gitlab.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --protocol http2 --metrics 127.0.0.1:20242 run
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cloudflared

[Install]
WantedBy=multi-user.target
