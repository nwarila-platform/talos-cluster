# TDNHQ-TALCL01 source of truth. Keep this file shell-compatible.

CLUSTER_NAME="talos-cluster"
CLUSTER_ENDPOINT="https://10.69.112.62:6443"

# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION="v1.13.9"
# The machine-config format `talosctl gen config` writes (--talos-version). It stays put when
# TALOS_VERSION moves: talosctl 1.14 writes multi-document defaults (its own EPHEMERAL VolumeConfig,
# a separate PodSecurity document, ...) that collide with cluster/patches/. Raise it deliberately,
# with the patches rewritten to the new documents.
TALOS_CONFIG_VERSION="v1.13"
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION="v1.36.3"

# renovate: datasource=helm depName=tigera-operator registryUrl=https://docs.tigera.io/calico/charts
CALICO_VERSION="v3.33.0"
# renovate: datasource=helm depName=longhorn registryUrl=https://charts.longhorn.io
LONGHORN_VERSION="1.12.1"
# renovate: datasource=helm depName=argo-cd registryUrl=https://argoproj.github.io/argo-helm
ARGO_CD_VERSION="10.10.5"
# renovate: datasource=helm depName=vault registryUrl=https://helm.releases.hashicorp.com
VAULT_CHART_VERSION="0.34.1"
# renovate: datasource=github-releases depName=rhysd/actionlint
ACTIONLINT_VERSION="v1.7.12"
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION="v3.22.1"
# renovate: datasource=github-releases depName=hashicorp/terraform
TERRAFORM_VERSION="v1.16.6"
# renovate: datasource=github-releases depName=hashicorp/vault
VAULT_CLI_VERSION="v2.2.0"
# Charts fetched by DIGEST (the version is metadata for humans and Renovate; the digest is the
# identity helm pulls). Update both together.
# renovate: datasource=helm depName=cert-manager registryUrl=oci://quay.io/jetstack/charts
CERT_MANAGER_VERSION="v1.21.2"
CERT_MANAGER_CHART="oci://quay.io/jetstack/charts/cert-manager@sha256:634dce9c13b56677a2c05e2ab76c312d0be2664022d5dd05815da67e1fd5f610"
# renovate: datasource=helm depName=cloudnative-pg registryUrl=oci://ghcr.io/cloudnative-pg/charts
CNPG_CHART_VERSION="0.29.1"
CNPG_CHART="oci://ghcr.io/cloudnative-pg/charts/cloudnative-pg@sha256:3245fa051bb21d0dd9246272f57a2760b4234817a164a3167d2a1e7fb9f63fd9"
# The Keycloak operator is vendored byte-exact from keycloak-k8s-resources (platform/keycloak-operator/
# upstream, SHA256SUMS checked by make validate); bump by re-vendoring the tagged files.
# renovate: datasource=github-releases depName=keycloak/keycloak-k8s-resources
KEYCLOAK_OPERATOR_VERSION="26.8.1"

CLUSTER_VIP="10.69.112.62"
CLUSTER_GATEWAY="10.69.112.1"
CLUSTER_NETMASK="24"
INSTALL_DISK="/dev/nvme0n1"
NIC_BUS_PATH="0000:00:1f.6"

CP_NODES="cp1:10.69.112.63 cp2:10.69.112.64 cp3:10.69.112.65"
WORKER_NODES="w1:10.69.112.68 w2:10.69.112.69 w3:10.69.112.70"
BOOTSTRAP_NODE="cp1:10.69.112.63"

# Built from cluster/schematic.yaml. Update both together.
TALOS_SCHEMATIC_ID="36cd6536eaec8ba802be2d38974108359069cedba8857302f69792b26b87c010"
TALOS_INSTALL_IMAGE="factory.talos.dev/installer-secureboot/${TALOS_SCHEMATIC_ID}:${TALOS_VERSION}"

STATE_DIR=".state"
